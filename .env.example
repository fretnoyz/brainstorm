# ── AI Provider Configuration (server-side only) ──────
# MODEL_SOURCE: "anthropic" | "openai"
# MODEL_NAME:   e.g. "claude-sonnet-4-20250514", "gpt-4o", etc.
# API_KEY:      Your API key for the chosen provider

MODEL_SOURCE=anthropic
MODEL_NAME=claude-sonnet-4-20250514
API_KEY=your-api-key-here

# ── Supabase (shared with mybiz) ──────
# VITE_ prefix = available in browser; non-prefixed = server-side only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
